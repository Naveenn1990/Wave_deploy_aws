{
  "info": {
    "name": "Firebase Analytics API",
    "description": "Complete API collection for Firebase Analytics (GA4) endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Dashboard Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/dashboard-summary?period=last30Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "dashboard-summary"],
          "query": [
            {
              "key": "period",
              "value": "last30Days",
              "description": "Options: today, yesterday, last7Days, last30Days, last90Days"
            }
          ]
        },
        "description": "Get overall dashboard metrics summary"
      }
    },
    {
      "name": "Active Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/active-users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "active-users"]
        },
        "description": "Get daily, weekly, and monthly active users"
      }
    },
    {
      "name": "Device Breakdown",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/device-breakdown?period=last7Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "device-breakdown"],
          "query": [
            {
              "key": "period",
              "value": "last7Days"
            }
          ]
        },
        "description": "Get device, OS, and browser analytics"
      }
    },
    {
      "name": "Audience Analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/audience?period=last30Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "audience"],
          "query": [
            {
              "key": "period",
              "value": "last30Days"
            }
          ]
        },
        "description": "Get geographic and demographic data"
      }
    },
    {
      "name": "Traffic Trends",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/traffic-trends?period=last7Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "traffic-trends"],
          "query": [
            {
              "key": "period",
              "value": "last7Days"
            }
          ]
        },
        "description": "Get daily traffic trends"
      }
    },
    {
      "name": "Top Screens",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/top-screens?period=last30Days&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "top-screens"],
          "query": [
            {
              "key": "period",
              "value": "last30Days"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Get most viewed screens and pages"
      }
    },
    {
      "name": "Retention Analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/retention?period=last90Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "retention"],
          "query": [
            {
              "key": "period",
              "value": "last90Days"
            }
          ]
        },
        "description": "Get user retention rates (Day 1, 7, 30)"
      }
    },
    {
      "name": "Notification Analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/notifications?period=last30Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "notifications"],
          "query": [
            {
              "key": "period",
              "value": "last30Days"
            }
          ]
        },
        "description": "Get notification open and click rates"
      }
    },
    {
      "name": "Real-time Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/realtime",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "realtime"]
        },
        "description": "Get currently active users (last 30 minutes)"
      }
    },
    {
      "name": "Traffic Sources",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/traffic-sources?period=last30Days",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "traffic-sources"],
          "query": [
            {
              "key": "period",
              "value": "last30Days"
            }
          ]
        },
        "description": "Get traffic source breakdown"
      }
    },
    {
      "name": "Custom Events",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/custom-events?period=last7Days&events=booking_completed,service_viewed",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "custom-events"],
          "query": [
            {
              "key": "period",
              "value": "last7Days"
            },
            {
              "key": "events",
              "value": "booking_completed,service_viewed",
              "description": "Comma-separated event names"
            }
          ]
        },
        "description": "Get custom event tracking data"
      }
    },
    {
      "name": "Clear Cache",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/clear-cache",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "clear-cache"]
        },
        "description": "Clear analytics cache to force fresh data"
      }
    },
    {
      "name": "Custom Date Range Example",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/firebase-analytics/dashboard-summary?startDate=2026-04-01&endDate=2026-05-06",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "firebase-analytics", "dashboard-summary"],
          "query": [
            {
              "key": "startDate",
              "value": "2026-04-01",
              "description": "Format: YYYY-MM-DD"
            },
            {
              "key": "endDate",
              "value": "2026-05-06",
              "description": "Format: YYYY-MM-DD"
            }
          ]
        },
        "description": "Example using custom date range instead of period"
      }
    }
  ]
}
